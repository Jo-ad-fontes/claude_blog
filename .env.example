# 이 파일을 .env로 복사하고 실제 값을 채운다.
# .env는 반드시 .gitignore에 있어야 한다.

# 파이프라인 전용 Anthropic API 키. 개인 구독/개발용 키와 분리한다.
# Console → API keys → Create key. 이름을 claude-blog-pipeline처럼
# 용도로 지어두면 비용 추적과 폐기가 쉽다. Limits에서 월 지출 한도도 건다.
ANTHROPIC_API_KEY=

# GitHub — public repo 읽기 전용 토큰 (star/release/commit 조회용)
GITHUB_TOKEN=

# 샌드박스 컨테이너에는 위 값을 절대 주입하지 않는다.
# 컨테이너 안에서 Claude Code를 돌려야 할 일이 생기면 별도의
# 저한도 API 키를 하나 더 발급해서 쓴다.
